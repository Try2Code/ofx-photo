        self.scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        self.scroll.setFocusPolicy(Qt.StrongFocus)
        self.param_host = QWidget()
        self.param_layout = QVBoxLayout(self.param_host)
        self.param_layout.setAlignment(Qt.AlignTop)
        self.scroll.setWidget(self.param_host)
        pv.addWidget(self.scroll, 1)

        lay.addWidget(panel, 0)
        self.setCentralWidget(root)
        self.setStatusBar(QStatusBar())

        self._load_choices()
        self.cb_category.currentTextChanged.connect(self.on_category)
        self.cb_preset.currentTextChanged.connect(self.on_preset_change)

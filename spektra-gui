        p = self.rend.by_name()
        self.cb_category.addItems(p[cli.P_CATEGORY]["choices"])
        self.cb_input.addItems(p[cli.P_INPUT_CS]["choices"])
        idx = self.cb_input.findText("Linear Rec.709")
        if idx >= 0:
            self.cb_input.setCurrentIndex(idx)
        self._refresh_presets()
        self._refresh_user()

    def _refresh_presets(self):
        cat = self.cb_category.currentText()
        names = self.rend.by_name([(cli.P_CATEGORY, cat)])[cli.P_SELECTION]["choices"]
        self.cb_preset.blockSignals(True)
        self.cb_preset.clear()
        self.cb_preset.addItems(names)
        self.cb_preset.blockSignals(False)

    def _refresh_user(self):
        names = self.rend.by_name()[cli.P_USER_PRESET]["choices"]
        self.cb_user.blockSignals(True)
        self.cb_user.clear()
        self.cb_user.addItems(["(none)"] + [n for n in names if n != "No presets found"])
        self.cb_user.blockSignals(False)

    # ---- parameter panel, built from what the plugin reports

    def rebuild_params(self):
        while self.param_layout.count():
            item = self.param_layout.takeAt(0)
            w = item.widget()
            if w:
                # Unparent at once.  deleteLater alone leaves the old widgets
                # attached until the event loop gets round to them, so a rebuild
                # could still find the previous build's section headers.
                w.setParent(None)
                w.deleteLater()
        self.widgets.clear()

        params = self.rend.params
        groups = {p["name"]: p["label"] for p in params if p["type"] == "OfxParamTypeGroup"}
        show_all = self.chk_all.isChecked()

        # Collect by group first.  The plugin does not declare its parameters
        # contiguously - "Print" comes in three separate runs and "Film" in two
        # - so walking the list and starting a section whenever the parent
        # changes produced the same title several times over.
        sections: dict[str, list[dict]] = {}
        for p in params:
            if p["type"] == "OfxParamTypeGroup":
                continue
            if p.get("secret"):
                continue
            if not show_all and not (p["name"].startswith("quick")
                                     or p.get("parent") in DEFAULT_GROUPS):
                continue
            if p["name"] in (cli.P_CATEGORY, cli.P_SELECTION, cli.P_USER_PRESET,
                             cli.P_INPUT_CS, cli.P_PRESET_NAME, cli.P_OUTPUT_CS):
                continue
            if p["name"] in PIPELINE_OWNED:
                continue
            sections.setdefault(p.get("parent") or "", []).append(p)

        if self.tabbed:
            self._lay_out_tabs(sections, groups, show_all)
        else:
            self._lay_out_column(sections, groups, show_all)

        if not self.widgets:
            self.param_layout.addWidget(
                QLabel("No quick parameters; tick the box above."))
        else:
            self.sync_widgets()

    def _lay_out_tabs(self, sections, groups, show_all):
        """Five tabs, after the upstream spektrafilm GUI."""
        tabs = QTabWidget()
        tabs.setObjectName("controlsTabWidget")
        tabs.setDocumentMode(True)
        tabs.setUsesScrollButtons(False)
        tabs.tabBar().setDrawBase(False)

        placed: set[str] = set()
        for title, members in TABS:
            present = [g for g in members if sections.get(g)]
            placed.update(present)
            # An empty tab stays clickable and explains itself; disabling it
            # made the click do nothing at all, with no reason given.
            tabs.addTab(self._build_tab(present, sections, groups, show_all), title)

        # A group the map does not mention still has to appear somewhere.
        leftover = [g for g in sections if g not in placed]
        if leftover:
            tabs.addTab(self._build_tab(leftover, sections, groups, show_all), "OTHER")

        self.param_layout.addWidget(tabs)

    def _build_tab(self, group_names, sections, groups, show_all):
        inner = QWidget()
        column = QVBoxLayout(inner)
        column.setAlignment(Qt.AlignTop)
        column.setContentsMargins(4, 4, 4, 4)

        if not group_names:
            hint = QLabel("Nothing here until \u201cShow every parameter\u201d is ticked.")
            hint.setWordWrap(True)
            hint.setObjectName("muted")
            column.addWidget(hint)

        for parent in group_names:
            # Within a tab there are few enough groups to open them by default.
            self._add_section(column, parent, sections.get(parent) or [], groups,
                              default_open=not show_all or len(group_names) <= 6)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setFrameShape(QScrollArea.NoFrame)
        scroll.setWidget(inner)
        return scroll

    def _lay_out_column(self, sections, groups, show_all):
        """Every group in one scrolling column, Effects last."""
        ordered = ([(k, v) for k, v in sections.items() if k not in LAST_GROUPS]
                   + [(k, v) for k, v in sections.items() if k in LAST_GROUPS])
        for parent, items in ordered:
            self._add_section(self.param_layout, parent, items, groups,
                              default_open=not show_all)

    def _add_section(self, layout, parent, items, groups, default_open):
        """One foldable group of controls, appended to `layout`."""
        title = groups.get(parent, parent or "General")

        head = QToolButton()
        head.setText(f"{title}  ({len(items)})")
        head.setCheckable(True)
        head.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
        head.setObjectName("groupHead")
        head.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        layout.addWidget(head)

        holder = QWidget()
        form = QFormLayout(holder)
        form.setContentsMargins(4, 0, 0, 0)
        form.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)
        form.setRowWrapPolicy(QFormLayout.WrapLongRows)
        form.setLabelAlignment(Qt.AlignLeft)
        layout.addWidget(holder)

        # Remember which groups the user left open across rebuilds.
        open_now = self.group_open.get(parent, default_open)
        head.setChecked(open_now)
        holder.setVisible(open_now)
        head.setArrowType(Qt.DownArrow if open_now else Qt.RightArrow)

        def toggled(on, h=holder, b=head, key=parent):
            h.setVisible(on)
            b.setArrowType(Qt.DownArrow if on else Qt.RightArrow)
            self.group_open[key] = on

        head.toggled.connect(toggled)

        for p in items:
            if p["type"] == "OfxParamTypePushButton":
                b = QPushButton(p["label"])
                b.setToolTip(p.get("hint", ""))
                b.clicked.connect(lambda _, n=p["name"], lbl=p["label"]: self.fire(n, lbl))
                form.addRow("", b)
                continue
            w = self._widget_for(p)
            if w is None:
                continue
            w.setFocusPolicy(Qt.StrongFocus)
            w.installEventFilter(self.wheel_guard)
            w.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            if isinstance(w, QComboBox):
                w.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)
                w.setMinimumContentsLength(12)
            label = QLabel(p["label"])
            label.setWordWrap(True)
            form.addRow(label, w)

    def set_all_groups(self, open_: bool):
        for key in list(self.group_open):
            self.group_open[key] = open_
        for head in self.param_host.findChildren(QToolButton):
            if head.objectName() == "groupHead":
                head.setChecked(open_)

    def _widget_for(self, p):
        t, name = p["type"], p["name"]
        if t == "OfxParamTypeBoolean":
            w = QCheckBox()
            w.setChecked(bool(p["value"][0]))
            w.setToolTip(p.get("hint", ""))
            w.toggled.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("bool", w)
            return w
        if t == "OfxParamTypeChoice":
            w = QComboBox()
            w.addItems(p["choices"])
            w.setCurrentIndex(min(p["value"], len(p["choices"]) - 1))
            w.setToolTip(p.get("hint", ""))
            w.currentIndexChanged.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("choice", w)
            return w
        if t in ("OfxParamTypeDouble", "OfxParamTypeInteger"):
            integer = t == "OfxParamTypeInteger"
            lo = p.get("displayMin", p.get("min", 0.0))
            hi = p.get("displayMax", p.get("max", 1.0))
            # A few parameters declare an enormous nominal range; fall back to
            # something a slider can actually address.
            if not (hi > lo) or (hi - lo) > 1e5:
                lo, hi = p.get("min", 0.0), p.get("max", 1.0)
            if not (hi > lo) or (hi - lo) > 1e5:
                v = float(p["value"][0])
                lo, hi = v - 10.0, v + 10.0
            w = SliderRow(lo, hi, p["value"][0], integer=integer)
            w.setToolTip(p.get("hint", ""))
            w.valueChanged.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("int" if integer else "double", w)
            return w
        return None

    # ---- gathering the parameter list for a render

    def base_sets(self) -> list[tuple[str, str]]:
        """Preset and colourspace: everything that defines the starting point."""
        sets = [(cli.P_CATEGORY, self.cb_category.currentText()),
                (cli.P_SELECTION, self.cb_preset.currentText())]
        if self.cb_user.currentIndex() > 0:
            sets += [(cli.P_USER_PRESET, self.cb_user.currentText()), (cli.P_LOAD, "")]
        sets.append((cli.P_INPUT_CS, self.cb_input.currentText()))
        return sets

    def _value_str(self, name: str) -> str:
        kind, w = self.widgets[name]
        if kind == "bool":
            return "true" if w.isChecked() else "false"
        if kind == "choice":
            return w.currentText()
        if kind == "int":
            return str(int(w.value()))
        return f"{w.value():g}"

    def session(self, for_preview: bool = True) -> dict:
        """Everything this window holds, as the JSON the CLI also speaks."""
        s = cli.default_session()
        s["input"] = str(self.source_path) if self.source_path else None
        s["bundle"] = str(self.rend.bundle)
        s["preset"] = {"category": self.cb_category.currentText(),
                       "selection": self.cb_preset.currentText()}
        s["user_preset"] = (self.cb_user.currentText()
                            if self.cb_user.currentIndex() > 0 else None)
        s["input_colorspace"] = self.cb_input.currentText()
        s["params"] = dict(self.extra_params)
        s["params"].update({n: self._value_str(n) for n in self.widgets if n in self.dirty})
        s["seed"] = int(self.sp_seed.value()) if self.chk_seed.isChecked() else None
        s["raw_exposure_bias"] = self.chk_evbias.isChecked()
        s["crop"] = self.view.crop
        s["preview"] = {"long_edge": PREVIEW_EDGE} if for_preview else None

        chain = []
        if self.chk_diffuse.isChecked():
            chain.append({"bundle": "diffuse", "params": {}})
        if self.chk_lens.isChecked():
            params = {}
            if self.cb_vignette.currentText() != "Off":
                params["quickVignetteEnabled"] = "true"
                params["quickVignettePreset"] = self.cb_vignette.currentText()
            if self.cb_distort.currentText() != "Off":
                params["quickLensDistortionEnabled"] = "true"
                params["quickLensDistortionPreset"] = self.cb_distort.currentText()
            chain.append({"bundle": "lens", "params": params})
        s["chain"] = chain
        return s

    def current_sets(self) -> list[tuple[str, str]]:
        return cli.session_to_sets(self.session())

    def apply_session(self, s: dict):
        """Restore the window from a session, the inverse of session()."""
        self.syncing = True
        try:
            preset = s.get("preset") or {}
            if preset.get("category"):
                self.cb_category.setCurrentText(preset["category"])
                self._refresh_presets()
            if preset.get("selection"):
                self.cb_preset.setCurrentText(preset["selection"])
            if s.get("input_colorspace"):
                self.cb_input.setCurrentText(s["input_colorspace"])
            self.cb_user.setCurrentIndex(
                max(0, self.cb_user.findText(s["user_preset"])) if s.get("user_preset") else 0)
            self.chk_seed.setChecked(s.get("seed") is not None)
            if s.get("seed") is not None:
                self.sp_seed.setValue(int(s["seed"]))

            self.chk_evbias.setChecked(bool(s.get("raw_exposure_bias")))
            self.view.set_crop(s.get("crop"))
            self.chk_crop.setChecked(bool(s.get("crop")))
            self._show_crop_size()
            self.chk_diffuse.setChecked(False)
            self.chk_lens.setChecked(False)
            self.cb_vignette.setCurrentText("Off")
            self.cb_distort.setCurrentText("Off")
            for step in s.get("chain") or []:
                b = str(step.get("bundle", "")).lower()
                pr = step.get("params") or {}
                if "diffuse" in b:
                    self.chk_diffuse.setChecked(True)
                elif "lens" in b:
                    self.chk_lens.setChecked(True)
                    if pr.get("quickVignettePreset"):
                        self.cb_vignette.setCurrentText(pr["quickVignettePreset"])
                    if pr.get("quickLensDistortionPreset"):
                        self.cb_distort.setCurrentText(pr["quickLensDistortionPreset"])
        finally:
            self.syncing = False

        self.dirty.clear()
        self.extra_params.clear()
        self.sync_widgets()
        # Re-apply the session's own overrides on top of the preset.
        self.syncing = True
        try:
            for name, value in (s.get("params") or {}).items():
                entry = self.widgets.get(name)
                if not entry:
                    # Not shown in the panel, but it still has to reach the plugin.
                    self.extra_params[name] = str(value)
                    continue
                kind, w = entry
                w.blockSignals(True)
                if kind == "bool":
                    w.setChecked(str(value).lower() in ("1", "true", "yes", "on"))
                elif kind == "choice":
                    w.setCurrentText(str(value))
                else:
                    w.setValue(float(value))
                w.blockSignals(False)
                self.dirty.add(name)
        finally:
            self.syncing = False

        if s.get("input"):
            self.load_path(Path(s["input"]))
        else:
            self.on_change()

    def export_session(self):
        default = str(Path.home() / "spektra-session.json")
        path, _ = QFileDialog.getSaveFileName(self, "Export session", default,
                                              "JSON (*.json)")
        if not path:
            return
        Path(path).write_text(json.dumps(self.session(), indent=2) + "\n")
        self.statusBar().showMessage(f"session -> {path}", 6000)

    def import_session(self):
        path, _ = QFileDialog.getOpenFileName(self, "Import session",
                                              str(Path.home()), "JSON (*.json)")
        if not path:
            return
        try:
            self.apply_session(cli.load_session(path))
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            return
        self.statusBar().showMessage(f"loaded session {Path(path).name}", 6000)

    def on_edit(self, name: str):
        if self.syncing:
            return
        self.dirty.add(name)
        # Choosing a preset for an effect that is switched off looks broken:
        # nothing happens.  Switch it on, the way picking a preset implies.
        if name.endswith("Preset"):
            enable = name[: -len("Preset")] + "Enabled"
            entry = self.widgets.get(enable)
            if entry and entry[0] == "bool" and not entry[1].isChecked():
                self.syncing = True
                try:
                    entry[1].setChecked(True)
                finally:
                    self.syncing = False
                self.dirty.add(enable)
                self.statusBar().showMessage(
                    f"switched on {enable.removeprefix('quick')} to apply the preset",
                    4000)
        entry = self.widgets.get(name)
        if entry and entry[0] == "choice":
            self.refresh_choices()
        self.on_change()

    @staticmethod
    def _set_choices(w, options, index):
        """Replace a dropdown's options, keeping the selection where we can.

        Several choices are dependent: picking a Stock Category rewrites the
        Stock list, and the plugin does that on its side.  A panel that only
        ever wrote values would leave the old list on screen.
        """
        current = [w.itemText(i) for i in range(w.count())]
        if current != list(options):
            keep = w.currentText()
            w.clear()
            w.addItems(options)
            at = w.findText(keep)
            w.setCurrentIndex(at if at >= 0 else
                              min(max(int(index), 0), max(len(options) - 1, 0)))
        elif 0 <= int(index) < w.count():
            w.setCurrentIndex(int(index))

    def refresh_choices(self):
        """Re-read every dropdown's options from the plugin.

        Only worth doing after a choice is edited, since those are what drive
        the dependent lists; it costs one describe call.
        """
        if not self.widgets:
            return
        state = self.rend.by_name(self.current_sets())
        self.syncing = True
        try:
            for name, (kind, w) in self.widgets.items():
                if kind != "choice":
                    continue
                p = state.get(name)
                if not p or "choices" not in p:
                    continue
                w.blockSignals(True)
                # A dropdown the user has set keeps their choice; the rest
                # follow whatever the plugin now reports.
                self._set_choices(w, p["choices"],
                                  w.currentIndex() if name in self.dirty else p["value"])
                w.blockSignals(False)
        finally:
            self.syncing = False

    def sync_widgets(self):
        """Pull the values the preset actually produced back into the panel."""
        if not self.widgets:
            return
        state = self.rend.by_name(self.base_sets())
        self.syncing = True
        try:
            for name, (kind, w) in self.widgets.items():
                p = state.get(name)
                if p is None or name in self.dirty:
                    continue
                w.blockSignals(True)
                if kind == "bool":
                    w.setChecked(bool(p["value"][0]))
                elif kind == "choice":
                    self._set_choices(w, p["choices"], p["value"])
                else:
                    w.setValue(p["value"][0])
                    w.setBaseline(p["value"][0])
                w.blockSignals(False)
        finally:
            self.syncing = False

    # ---- actions

    def open_photo(self):
        start = self.settings.value("last_dir", str(Path.home()))
        path, _ = QFileDialog.getOpenFileName(
            self, "Open a photo", start,
            "Photos (*.jpg *.jpeg *.png *.tif *.tiff *.JPG *.NEF *.CR2 *.CR3 *.ARW "
            "*.DNG *.RAF *.RW2 *.ORF);;All files (*)")
        if not path:
            return
        self.load_path(Path(path))

    def load_path(self, path: Path):
        self.statusBar().showMessage(f"reading {path.name}…")
        QApplication.processEvents()
        try:
            linear, _, meta = cli.load_photo(path)
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            self.statusBar().clearMessage()
            return
        self.source_path, self.raw_linear, self.meta = path, linear, meta
        self.update_evbias_state()
        self.rebuild_source()
        h, w = linear.shape[:2]
        self.lbl_file.setText(f"{path.name}   {w}×{h}")
        self._show_crop_size()
        # Qt appends the display name, so this reads "photo.jpg - Spektra Photo".
        self.setWindowTitle(path.name)
        self.settings.setValue("last_dir", str(path.parent))
        self.on_change()

    def on_lens_choice(self):
        """Choosing a lens effect arms the pass, which would otherwise be off."""
        if self.syncing:
            return
        wants = (self.cb_vignette.currentText() != "Off"
                 or self.cb_distort.currentText() != "Off")
        if wants and not self.chk_lens.isChecked():
            self.chk_lens.blockSignals(True)
            self.chk_lens.setChecked(True)
            self.chk_lens.blockSignals(False)
            self.statusBar().showMessage("lens pass switched on", 4000)
        self.on_change()

    def on_crop(self, crop):
        """The crop only changes what is kept, so nothing needs re-rendering."""
        self._show_crop_size()
        self.statusBar().showMessage(
            "crop cleared" if not crop else
            "crop set - the frame is still rendered whole, so the optics stay put",
            6000)

    def _show_crop_size(self):
        crop = self.view.crop
        if not crop or self.full_linear is None:
            self.lbl_crop.setText("")
            return
        x0, y0, x1, y1 = cli.crop_box(self.full_linear.shape[:2], crop)
        self.lbl_crop.setText(f"\u2192 {x1 - x0}\u00d7{y1 - y0}")

    def on_evbias(self):
        """Rescale the pixels, then re-render.  The gain is applied to the image
        before the plugin sees it, so the preview has to be rebuilt."""
        self.rebuild_source()
        self.on_change()

    def update_evbias_state(self):
        """Grey the box out when it cannot do anything, and say why."""
        is_raw = bool(self.meta.get("is_raw"))
        bias = self.meta.get("exposure_bias")
        usable = is_raw and bool(bias)
        self.chk_evbias.setEnabled(usable)
        if not self.source_path:
            why = "Open a raw file to use this."
        elif not is_raw:
            why = ("Raw files only. A JPEG already carries the camera's exposure\n"
                   "compensation in its rendering, so undoing it would apply it twice.")
        elif not bias:
            why = "This raw file records no exposure compensation."
        else:
            why = (f"Undo the {bias:+.2f} EV the camera was told to apply, so this raw\n"
                   f"lands where its JPEG would (x{2.0 ** -float(bias):.2f}).")
        self.chk_evbias.setToolTip(why)
        self.chk_evbias.setText("EV bias" if usable or not self.source_path
                                else "EV bias (raw only)")

    def rebuild_source(self):
        if self.raw_linear is None:
            return
        self.full_linear = self._with_bias(self.raw_linear)
        self.preview_linear = cli.resize_linear(self.full_linear, PREVIEW_EDGE)
        self.full_render = None

    def _with_bias(self, linear):
        if not self.chk_evbias.isChecked():
            return linear
        out, note = cli.apply_exposure_bias(linear, self.meta)
        if "undid" in note:
            self.statusBar().showMessage(note, 4000)
        return out

    def on_category(self):
        self._refresh_presets()
        self.on_preset_change()

    def on_preset_change(self):
        # A new preset replaces the whole look, so previous tweaks no longer apply.
        self.dirty.clear()
        self.extra_params.clear()
        self.sync_widgets()
        self.on_change()

    def on_change(self):
        if self.preview_linear is None:
            return
        if self.job and self.job.isRunning():
            self.pending = True  # coalesce: re-render once the current one lands
            return
        self.pending = False
        out = os.environ.get("SPEKTRA_SESSION_OUT")
        if out:
            try:
                Path(out).write_text(json.dumps(self.session(), indent=2) + "\n")
            except OSError:
                pass
        self.statusBar().showMessage("rendering preview…")
        self.job = RenderJob(self.rend, self.preview_linear, self.session())
        self.job.done.connect(self.on_rendered)
        self.job.start()

    def on_rendered(self, result, err):
        if err:
            self.statusBar().showMessage(err[:200])
        elif self.pending:
            # Settings changed while this was rendering, so it is already out of
            # date.  Drop it rather than briefly showing a stale preview.
            pass
        else:
            self.rendered = result
            if not self.showing_original:
                self._display(result)
            self.statusBar().showMessage("preview ready", 2000)
        if self.pending:
            self.on_change()

    def _display(self, img, encoded: bool = True):
        """encoded=True for plugin output, which already carries its display
        transform; False for the untouched source, which is still linear."""
        rgb = img[..., :3] if encoded else cli.linear_to_srgb(img[..., :3])
        u8 = (np.clip(rgb, 0.0, 1.0) * 255.0 + 0.5).astype(np.uint8)
        self.view.show_array(np.ascontiguousarray(u8))

    def _show_original(self, on):
        self.showing_original = on
        if on and self.preview_linear is not None:
            self._display(self.preview_linear, encoded=False)
        elif self.rendered is not None:
            self._display(self.rendered)

    def render_full(self):
        if self.full_linear is None:
            return
        h, w = self.full_linear.shape[:2]
        self.statusBar().showMessage(f"rendering {w}×{h}…")
        QApplication.processEvents()
        try:
            self.full_render = cli.render_pipeline(
                self.session(for_preview=False), self.full_linear, self.rend)
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            return
        self._display(self.full_render)
        self.statusBar().showMessage(f"full resolution {w}×{h} ready", 4000)

    def save_image(self):
        if self.full_linear is None:
            return
        default = str(self.source_path.with_name(self.source_path.stem + "_spektra.jpg"))
        path, _ = QFileDialog.getSaveFileName(
            self, "Save image", default,
            "JPEG (*.jpg);;PNG 16-bit (*.png);;TIFF 16-bit (*.tif)")
        if not path:
            return
        path = Path(path)
        if self.full_render is None:
            self.render_full()
        # The crop is applied to the finished render, never before it.
        saved = cli.apply_crop(self.full_render, self.view.crop)
        depth = 8 if path.suffix.lower() in (".jpg", ".jpeg") else 16
        preset = self.cb_preset.currentText()
        self.meta["processing_note"] = f"spektra (ofx-photo) - {preset}" if preset \
            else "spektra (ofx-photo)"
        cli.save_photo(path, saved, depth, 95, self.meta)
        self.statusBar().showMessage(f"saved {path}", 5000)

    # Buttons that throw something away get asked about first.
    DESTRUCTIVE = {
        "resetDefaults": "Delete your saved defaults and return every control to "
                         "the factory values?",
        "pasteParams": "Replace the current settings with whatever is on the "
                       "clipboard?",
    }

    def fire(self, name: str, label: str):
        """Press a plugin push button: it acts on being told it changed."""
        question = self.DESTRUCTIVE.get(name)
        if question and QMessageBox.question(
                self, label, question,
                QMessageBox.Yes | QMessageBox.No) != QMessageBox.Yes:
            return

        self.statusBar().showMessage(f"{label}\u2026")
        QApplication.processEvents()
        ok, note = self.rend.fire(self.current_sets() + [(name, "")])
        self.statusBar().showMessage(note or (f"{label} done" if ok
                                              else f"{label} failed"), 12000)
        if not ok and not note:
            QMessageBox.warning(self, label, f"{label} did not complete.")
        # A preset or defaults change rewrites values and dropdown contents.
        if name in ("loadPreset", "pasteParams", "resetDefaults", "savePreset"):
            self._refresh_user()
            self.dirty.clear()
            self.sync_widgets()
            self.refresh_choices()
            self.on_change()

    def save_preset(self):
        name, ok = QInputDialog.getText(self, "Save preset", "Name for this look:")
        if not ok or not name.strip():
            return
        sets = self.current_sets() + [(cli.P_PRESET_NAME, name.strip()),
                                      (cli.P_SAVE, "")]
        try:
            self.rend.describe(sets)  # cheapest way to run the actions
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            return
        self._refresh_user()
        self.statusBar().showMessage(f"saved preset {name!r}", 5000)

    def reset_params(self):
        self.dirty.clear()
        self.extra_params.clear()
        self.sync_widgets()
        self.on_change()

    # ---- drag and drop

    @staticmethod
    def _dropped_path(event) -> Path | None:
        if not event.mimeData().hasUrls():
            return None
        for url in event.mimeData().urls():
            if url.isLocalFile():
                p = Path(url.toLocalFile())
                if p.suffix.lower() in SUPPORTED_SUFFIXES:
                    return p
        return None

    def dragEnterEvent(self, event):
        if self._dropped_path(event):
            event.acceptProposedAction()

    def dragMoveEvent(self, event):
        if self._dropped_path(event):
            event.acceptProposedAction()

    def dropEvent(self, event):
        path = self._dropped_path(event)
        if not path:
            return
        event.acceptProposedAction()
        if path.suffix.lower() == ".json":
            self.apply_session(cli.load_session(str(path)))
        else:
            self.load_path(path)

    def toggle_theme(self):
        self.set_theme("light" if self.theme == "dark" else "dark")

    def set_theme(self, name: str):
        self.theme = name
        apply_theme(QApplication.instance(), name)
        # The button shows where clicking would take you.
        self.b_theme.setText("\u2600" if name == "dark" else "\u263e")
        self.settings.setValue("theme", name)

    def _restore(self):
        g = self.settings.value("geometry")
        if g:
            self.restoreGeometry(g)
        self.set_theme(self.settings.value("theme", "dark"))

    def closeEvent(self, e):
        self.settings.setValue("geometry", self.saveGeometry())
        super().closeEvent(e)


APP_ID = "ofx-photo"


def install_identity(app):
    """Tell the desktop which application this window belongs to.

    A compositor matches a window to its .desktop file by app id, and Qt
    defaults that to the executable name.  Without this the shell looks for
    spektra-gui.desktop, finds nothing, and shows a generic icon however well
    the real one is installed.
    """
    app.setApplicationName(APP_ID)          # X11 WM_CLASS
    app.setApplicationDisplayName("Spektra Photo")
    app.setDesktopFileName(APP_ID)          # Wayland app id

    icon = QIcon.fromTheme(APP_ID)
    if icon.isNull():
        # Not installed: fall back to the copies in the checkout.
        for candidate in (HERE / "desktop" / "ofx-photo.svg",
                          HERE.parent / "desktop" / "ofx-photo.svg"):
            if candidate.is_file():
                icon = QIcon(str(candidate))
                break
    if not icon.isNull():
        app.setWindowIcon(icon)


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    install_identity(app)
    rend = cli.Renderer(cli.find_renderer(), cli.find_bundle(None))
    win = Window(rend)
    # The tabs are the default; --single-column restores the older layout,
    # which put every group in one scrolling list.
    if "--single-column" in sys.argv or "--column" in sys.argv:
        win.tabbed = False
        win.rebuild_params()

    # A catalog hands over a whole selection, so take more than one path: the
    # first opens here and the rest get their own window.  Anything else would
    # silently drop all but the first.
    args = [Path(a) for a in sys.argv[1:] if not a.startswith("-")]
    for extra in args[1:]:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), str(extra)],
                         start_new_session=True)
    if args:
        first = args[0]
        if first.suffix.lower() == ".json":
            win.apply_session(cli.load_session(str(first)))
        else:
            win.load_path(first)
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()

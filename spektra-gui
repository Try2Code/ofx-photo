    def _load_choices(self):
        p = self.rend.by_name()
        self.cb_category.addItems(p[cli.P_CATEGORY]["choices"])
        self.cb_input.addItems(p[cli.P_INPUT_CS]["choices"])
        idx = self.cb_input.findText("Linear Rec.709")
        if idx >= 0:
            self.cb_input.setCurrentIndex(idx)
        self._refresh_presets()
        self._refresh_user()

    def _refresh_presets(self):
        cat = self.cb_category.currentText()
        names = self.rend.by_name([(cli.P_CATEGORY, cat)])[cli.P_SELECTION]["choices"]
        self.cb_preset.blockSignals(True)
        self.cb_preset.clear()
        self.cb_preset.addItems(names)
        self.cb_preset.blockSignals(False)

    def _refresh_user(self):
        names = self.rend.by_name()[cli.P_USER_PRESET]["choices"]
        self.cb_user.blockSignals(True)
        self.cb_user.clear()
        self.cb_user.addItems(["(none)"] + [n for n in names if n != "No presets found"])
        self.cb_user.blockSignals(False)

    # ---- parameter panel, built from what the plugin reports

    def rebuild_params(self):
        while self.param_layout.count():
            item = self.param_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()
        self.widgets.clear()

        params = self.rend.params
        groups = {p["name"]: p["label"] for p in params if p["type"] == "OfxParamTypeGroup"}
        show_all = self.chk_all.isChecked()

        current = None
        form = None
        for p in params:
            if p["type"] in ("OfxParamTypeGroup", "OfxParamTypePushButton"):
                continue
            if p.get("secret"):
                continue
            if not show_all and not p["name"].startswith("quick"):
                continue
            if p["name"] in (cli.P_CATEGORY, cli.P_SELECTION, cli.P_USER_PRESET,
                             cli.P_INPUT_CS, cli.P_PRESET_NAME):
                continue

            parent = p.get("parent") or ""
            if parent != current:
                current = parent
                title = groups.get(parent, parent or "General")
                head = QToolButton()
                head.setText(title)
                head.setCheckable(True)
                head.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
                head.setStyleSheet(
                    "QToolButton{color:#8ab4f8;font-weight:bold;border:none;"
                    "margin-top:8px;text-align:left;}")
                head.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
                self.param_layout.addWidget(head)
                holder = QWidget()
                form = QFormLayout(holder)
                form.setContentsMargins(4, 0, 0, 0)
                form.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)
                form.setRowWrapPolicy(QFormLayout.WrapLongRows)
                form.setLabelAlignment(Qt.AlignLeft)
                self.param_layout.addWidget(holder)

                # Remember which groups the user left open across rebuilds.
                # With every parameter shown there are 49 of them, so they
                # start collapsed in that mode and open in the quick one.
                open_now = self.group_open.get(parent, not show_all)
                head.setChecked(open_now)
                holder.setVisible(open_now)
                head.setArrowType(Qt.DownArrow if open_now else Qt.RightArrow)

                def toggled(on, h=holder, b=head, key=parent):
                    h.setVisible(on)
                    b.setArrowType(Qt.DownArrow if on else Qt.RightArrow)
                    self.group_open[key] = on

                head.toggled.connect(toggled)

            w = self._widget_for(p)
            if w is not None and form is not None:
                w.setFocusPolicy(Qt.StrongFocus)
                w.installEventFilter(self.wheel_guard)
                w.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
                if isinstance(w, QComboBox):
                    # a long option must not widen the whole panel
                    w.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)
                    w.setMinimumContentsLength(12)
                label = QLabel(p["label"])
                label.setWordWrap(True)
                form.addRow(label, w)

        if not self.widgets:
            self.param_layout.addWidget(QLabel("No quick parameters; tick the box above."))
        else:
            self.sync_widgets()

    def set_all_groups(self, open_: bool):
        for key in list(self.group_open):
            self.group_open[key] = open_
        for head in self.param_host.findChildren(QToolButton):
            head.setChecked(open_)

    def _widget_for(self, p):
        t, name = p["type"], p["name"]
        if t == "OfxParamTypeBoolean":
            w = QCheckBox()
            w.setChecked(bool(p["value"][0]))
            w.setToolTip(p.get("hint", ""))
            w.toggled.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("bool", w)
            return w
        if t == "OfxParamTypeChoice":
            w = QComboBox()
            w.addItems(p["choices"])
            w.setCurrentIndex(min(p["value"], len(p["choices"]) - 1))
            w.setToolTip(p.get("hint", ""))
            w.currentIndexChanged.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("choice", w)
            return w
        if t == "OfxParamTypeDouble":
            w = QDoubleSpinBox()
            lo = p.get("displayMin", p.get("min", -1e6))
            hi = p.get("displayMax", p.get("max", 1e6))
            lo, hi = max(lo, -1e6), min(hi, 1e6)
            w.setRange(lo, hi)
            w.setDecimals(3)
            w.setSingleStep(max((hi - lo) / 100.0, 0.001))
            w.setValue(p["value"][0])
            w.setToolTip(p.get("hint", ""))
            w.valueChanged.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("double", w)
            return w
        if t == "OfxParamTypeInteger":
            w = QDoubleSpinBox()
            w.setDecimals(0)
            w.setRange(max(p.get("min", -1e6), -1e6), min(p.get("max", 1e6), 1e6))
            w.setValue(p["value"][0])
            w.valueChanged.connect(lambda _, n=name: self.on_edit(n))
            self.widgets[name] = ("int", w)
            return w
        return None

    # ---- gathering the parameter list for a render

    def base_sets(self) -> list[tuple[str, str]]:
        """Preset and colourspace: everything that defines the starting point."""
        sets = [(cli.P_CATEGORY, self.cb_category.currentText()),
                (cli.P_SELECTION, self.cb_preset.currentText())]
        if self.cb_user.currentIndex() > 0:
            sets += [(cli.P_USER_PRESET, self.cb_user.currentText()), (cli.P_LOAD, "")]
        sets.append((cli.P_INPUT_CS, self.cb_input.currentText()))
        return sets

    def _value_str(self, name: str) -> str:
        kind, w = self.widgets[name]
        if kind == "bool":
            return "true" if w.isChecked() else "false"
        if kind == "choice":
            return w.currentText()
        if kind == "int":
            return str(int(w.value()))
        return f"{w.value():g}"

    def session(self, for_preview: bool = True) -> dict:
        """Everything this window holds, as the JSON the CLI also speaks."""
        s = cli.default_session()
        s["input"] = str(self.source_path) if self.source_path else None
        s["bundle"] = str(self.rend.bundle)
        s["preset"] = {"category": self.cb_category.currentText(),
                       "selection": self.cb_preset.currentText()}
        s["user_preset"] = (self.cb_user.currentText()
                            if self.cb_user.currentIndex() > 0 else None)
        s["input_colorspace"] = self.cb_input.currentText()
        s["params"] = dict(self.extra_params)
        s["params"].update({n: self._value_str(n) for n in self.widgets if n in self.dirty})
        s["seed"] = int(self.sp_seed.value()) if self.chk_seed.isChecked() else None
        s["preview"] = {"long_edge": PREVIEW_EDGE} if for_preview else None
        return s

    def current_sets(self) -> list[tuple[str, str]]:
        return cli.session_to_sets(self.session())

    def apply_session(self, s: dict):
        """Restore the window from a session, the inverse of session()."""
        self.syncing = True
        try:
            preset = s.get("preset") or {}
            if preset.get("category"):
                self.cb_category.setCurrentText(preset["category"])
                self._refresh_presets()
            if preset.get("selection"):
                self.cb_preset.setCurrentText(preset["selection"])
            if s.get("input_colorspace"):
                self.cb_input.setCurrentText(s["input_colorspace"])
            self.cb_user.setCurrentIndex(
                max(0, self.cb_user.findText(s["user_preset"])) if s.get("user_preset") else 0)
            self.chk_seed.setChecked(s.get("seed") is not None)
            if s.get("seed") is not None:
                self.sp_seed.setValue(int(s["seed"]))
        finally:
            self.syncing = False

        self.dirty.clear()
        self.extra_params.clear()
        self.sync_widgets()
        # Re-apply the session's own overrides on top of the preset.
        self.syncing = True
        try:
            for name, value in (s.get("params") or {}).items():
                entry = self.widgets.get(name)
                if not entry:
                    # Not shown in the panel, but it still has to reach the plugin.
                    self.extra_params[name] = str(value)
                    continue
                kind, w = entry
                w.blockSignals(True)
                if kind == "bool":
                    w.setChecked(str(value).lower() in ("1", "true", "yes", "on"))
                elif kind == "choice":
                    w.setCurrentText(str(value))
                else:
                    w.setValue(float(value))
                w.blockSignals(False)
                self.dirty.add(name)
        finally:
            self.syncing = False

        if s.get("input"):
            self.load_path(Path(s["input"]))
        else:
            self.on_change()

    def export_session(self):
        default = str(Path.home() / "spektra-session.json")
        path, _ = QFileDialog.getSaveFileName(self, "Export session", default,
                                              "JSON (*.json)")
        if not path:
            return
        Path(path).write_text(json.dumps(self.session(), indent=2) + "\n")
        self.statusBar().showMessage(f"session -> {path}", 6000)

    def import_session(self):
        path, _ = QFileDialog.getOpenFileName(self, "Import session",
                                              str(Path.home()), "JSON (*.json)")
        if not path:
            return
        try:
            self.apply_session(cli.load_session(path))
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            return
        self.statusBar().showMessage(f"loaded session {Path(path).name}", 6000)

    def on_edit(self, name: str):
        if self.syncing:
            return
        self.dirty.add(name)
        self.on_change()

    def sync_widgets(self):
        """Pull the values the preset actually produced back into the panel."""
        if not self.widgets:
            return
        state = self.rend.by_name(self.base_sets())
        self.syncing = True
        try:
            for name, (kind, w) in self.widgets.items():
                p = state.get(name)
                if p is None or name in self.dirty:
                    continue
                w.blockSignals(True)
                if kind == "bool":
                    w.setChecked(bool(p["value"][0]))
                elif kind == "choice":
                    if p["value"] < w.count():
                        w.setCurrentIndex(p["value"])
                else:
                    w.setValue(p["value"][0])
                w.blockSignals(False)
        finally:
            self.syncing = False

    # ---- actions

    def open_photo(self):
        start = self.settings.value("last_dir", str(Path.home()))
        path, _ = QFileDialog.getOpenFileName(
            self, "Open a photo", start,
            "Photos (*.jpg *.jpeg *.png *.tif *.tiff *.JPG *.NEF *.CR2 *.CR3 *.ARW "
            "*.DNG *.RAF *.RW2 *.ORF);;All files (*)")
        if not path:
            return
        self.load_path(Path(path))

    def load_path(self, path: Path):
        self.statusBar().showMessage(f"reading {path.name}…")
        QApplication.processEvents()
        try:
            linear, _, meta = cli.load_photo(path)
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            self.statusBar().clearMessage()
            return
        self.source_path, self.full_linear, self.meta = path, linear, meta
        self.full_render = None
        h, w = linear.shape[:2]
        self.preview_linear = cli.resize_linear(linear, PREVIEW_EDGE)
        self.lbl_file.setText(f"{path.name}   {w}×{h}")
        self.settings.setValue("last_dir", str(path.parent))
        self.on_change()

    def on_category(self):
        self._refresh_presets()
        self.on_preset_change()

    def on_preset_change(self):
        # A new preset replaces the whole look, so previous tweaks no longer apply.
        self.dirty.clear()
        self.extra_params.clear()
        self.sync_widgets()
        self.on_change()

    def on_change(self):
        if self.preview_linear is None:
            return
        if self.job and self.job.isRunning():
            self.pending = True  # coalesce: re-render once the current one lands
            return
        self.pending = False
        out = os.environ.get("SPEKTRA_SESSION_OUT")
        if out:
            try:
                Path(out).write_text(json.dumps(self.session(), indent=2) + "\n")
            except OSError:
                pass
        self.statusBar().showMessage("rendering preview…")
        self.job = RenderJob(self.rend, self.preview_linear, self.current_sets())
        self.job.done.connect(self.on_rendered)
        self.job.start()

    def on_rendered(self, result, err):
        if err:
            self.statusBar().showMessage(err[:200])
        elif self.pending:
            # Settings changed while this was rendering, so it is already out of
            # date.  Drop it rather than briefly showing a stale preview.
            pass
        else:
            self.rendered = result
            if not self.showing_original:
                self._display(result)
            self.statusBar().showMessage("preview ready", 2000)
        if self.pending:
            self.on_change()

    def _display(self, img, encoded: bool = True):
        """encoded=True for plugin output, which already carries its display
        transform; False for the untouched source, which is still linear."""
        rgb = img[..., :3] if encoded else cli.linear_to_srgb(img[..., :3])
        u8 = (np.clip(rgb, 0.0, 1.0) * 255.0 + 0.5).astype(np.uint8)
        self.view.show_array(np.ascontiguousarray(u8))

    def _show_original(self, on):
        self.showing_original = on
        if on and self.preview_linear is not None:
            self._display(self.preview_linear, encoded=False)
        elif self.rendered is not None:
            self._display(self.rendered)

    def render_full(self):
        if self.full_linear is None:
            return
        h, w = self.full_linear.shape[:2]
        self.statusBar().showMessage(f"rendering {w}×{h}…")
        QApplication.processEvents()
        try:
            self.full_render = self.rend.render(
                self.full_linear, cli.session_to_sets(self.session(for_preview=False)))
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            return
        self._display(self.full_render)
        self.statusBar().showMessage(f"full resolution {w}×{h} ready", 4000)

    def save_image(self):
        if self.full_linear is None:
            return
        default = str(self.source_path.with_name(self.source_path.stem + "_spektra.jpg"))
        path, _ = QFileDialog.getSaveFileName(
            self, "Save image", default,
            "JPEG (*.jpg);;PNG 16-bit (*.png);;TIFF 16-bit (*.tif)")
        if not path:
            return
        path = Path(path)
        if self.full_render is None:
            self.render_full()
        depth = 8 if path.suffix.lower() in (".jpg", ".jpeg") else 16
        cli.save_photo(path, self.full_render, depth, 95, self.meta)
        self.statusBar().showMessage(f"saved {path}", 5000)

    def save_preset(self):
        name, ok = QInputDialog.getText(self, "Save preset", "Name for this look:")
        if not ok or not name.strip():
            return
        sets = self.current_sets() + [(cli.P_PRESET_NAME, name.strip()),
                                      (cli.P_SAVE, "")]
        try:
            self.rend.describe(sets)  # cheapest way to run the actions
        except SystemExit as e:
            QMessageBox.warning(self, "spektra", str(e))
            return
        self._refresh_user()
        self.statusBar().showMessage(f"saved preset {name!r}", 5000)

    def reset_params(self):
        self.dirty.clear()
        self.extra_params.clear()
        self.sync_widgets()
        self.on_change()

    def _restore(self):
        g = self.settings.value("geometry")
        if g:
            self.restoreGeometry(g)

    def closeEvent(self, e):
        self.settings.setValue("geometry", self.saveGeometry())
        super().closeEvent(e)


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    rend = cli.Renderer(cli.find_renderer(), cli.find_bundle(None))
    win = Window(rend)
    if len(sys.argv) > 1:
        arg = Path(sys.argv[1])
        if arg.suffix.lower() == ".json":
            win.apply_session(cli.load_session(str(arg)))
        else:
            win.load_path(arg)
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()

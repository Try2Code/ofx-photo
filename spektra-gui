class WheelGuard(QObject):
    """Stop combo boxes and spin boxes swallowing the scroll wheel.

    Qt sends the wheel to whatever sits under the pointer, so scrolling the
    panel would silently change parameter values.  Unfocused widgets now pass
    the event up to the scroll area instead.
    """

    def eventFilter(self, obj, ev):
        if ev.type() == QEvent.Wheel and not obj.hasFocus():
            ev.ignore()
            return True
        return super().eventFilter(obj, ev)


class SliderRow(QWidget):
    """A slider, its value, and a button that puts it back.

    Replaces the spin boxes: dragging beats clicking a tiny arrow 200 times,
    and "back to what the preset said" is one click rather than a guess.
    """

    valueChanged = pyqtSignal(float)
    STEPS = 1000

    def __init__(self, lo: float, hi: float, value: float, integer: bool = False):
        super().__init__()
        if not (hi > lo):
            hi = lo + 1.0
        self.lo, self.hi, self.integer = float(lo), float(hi), integer
        self._baseline = float(value)

        self.slider = QSlider(Qt.Horizontal)
        self.direct = integer and (hi - lo) <= self.STEPS
        self.slider.setRange(int(lo), int(hi)) if self.direct else \
            self.slider.setRange(0, self.STEPS)
        self.slider.setFocusPolicy(Qt.StrongFocus)

        self.readout = QLabel()
        self.readout.setMinimumWidth(56)
        self.readout.setAlignment(Qt.AlignRight | Qt.AlignVCenter)
        self.readout.setObjectName("readout")

        self.reset = QToolButton()
        self.reset.setText("↺")
        self.reset.setToolTip("Back to the preset's value")
        self.reset.setAutoRaise(True)
        self.reset.clicked.connect(lambda: self.setValue(self._baseline, notify=True))

        row = QHBoxLayout(self)
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(4)
        row.addWidget(self.slider, 1)
        row.addWidget(self.readout)
        row.addWidget(self.reset)

        self.setValue(value)
        self.slider.valueChanged.connect(self._moved)

    # -- mapping between the slider's integer steps and the real value
    def _to_slider(self, v: float) -> int:
        if self.direct:
            return int(round(v))
        frac = (v - self.lo) / (self.hi - self.lo)
        return int(round(min(max(frac, 0.0), 1.0) * self.STEPS))

    def _from_slider(self, i: int) -> float:
        if self.direct:
            return float(i)
        v = self.lo + (i / self.STEPS) * (self.hi - self.lo)
        return round(v) if self.integer else v

    def _moved(self, i):
        self._value = self._from_slider(i)
        self._refresh()
        self.valueChanged.emit(self._value)

    def _refresh(self):
        self.readout.setText(f"{self._value:.0f}" if self.integer
                             else f"{self._value:.3g}")
        at_base = abs(self._value - self._baseline) < 1e-9
        self.reset.setEnabled(not at_base)

    def value(self) -> float:
        return self._value

    def setValue(self, v: float, notify: bool = False):
        self._value = float(v)
        blocked = self.slider.blockSignals(True)
        self.slider.setValue(self._to_slider(self._value))
        self.slider.blockSignals(blocked)
        self._refresh()
        if notify:
            self.valueChanged.emit(self._value)

    def setBaseline(self, v: float):
        self._baseline = float(v)
        self._refresh()

    def wheelEvent(self, ev):
        # Let the panel scroll past unless this row has been clicked into.
        if not self.slider.hasFocus():
            ev.ignore()
        else:
            super().wheelEvent(ev)


# ------------------------------------------------------------- render thread


class RenderJob(QThread):
    done = pyqtSignal(object, str)

    def __init__(self, rend, linear, session):
        super().__init__()
        self.rend, self.linear, self.session = rend, linear, session

    def run(self):
        try:
            self.done.emit(cli.render_pipeline(self.session, self.linear, self.rend), "")
        except SystemExit as e:
            self.done.emit(None, str(e))
        except Exception as e:  # noqa: BLE001 - surface anything to the status bar
            self.done.emit(None, f"{type(e).__name__}: {e}")



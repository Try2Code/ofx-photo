def apply_theme(app, name: str) -> None:
    """Repaint the whole application in the chosen theme."""
    c = THEMES.get(name, THEMES["dark"])
    pal = QPalette()
    pal.setColor(QPalette.Window, QColor(c["window"]))
    pal.setColor(QPalette.WindowText, QColor(c["text"]))
    pal.setColor(QPalette.Base, QColor(c["base"]))
    pal.setColor(QPalette.AlternateBase, QColor(c["window"]))
    pal.setColor(QPalette.ToolTipBase, QColor(c["base"]))
    pal.setColor(QPalette.ToolTipText, QColor(c["text"]))
    pal.setColor(QPalette.Text, QColor(c["text"]))
    pal.setColor(QPalette.Button, QColor(c["button"]))
    pal.setColor(QPalette.ButtonText, QColor(c["text"]))
    pal.setColor(QPalette.BrightText, QColor("#ff5555"))
    pal.setColor(QPalette.Highlight, QColor(c["highlight"]))
    pal.setColor(QPalette.HighlightedText, QColor(c["highlightText"]))
    pal.setColor(QPalette.Disabled, QPalette.Text, QColor(c["muted"]))
    pal.setColor(QPalette.Disabled, QPalette.ButtonText, QColor(c["muted"]))
    app.setPalette(pal)
    # Object names let a theme change restyle widgets already on screen,
    # without rebuilding the parameter panel.
    app.setStyleSheet(f"""
        QLabel#readout {{ color: {c['readout']}; }}
        QLabel#muted {{ color: {c['muted']}; }}
        QToolButton#groupHead {{ color: {c['head']}; font-weight: bold;
                                 border: none; margin-top: 8px; text-align: left; }}
        QLabel#imageView {{ background: {c['view']};
                            border: 1px solid {c['viewBorder']}; }}
    """)



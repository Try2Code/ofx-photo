)
cli = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(cli)

PREVIEW_EDGE = 1100


# resize_linear lives in the CLI module, so both sides scale previews alike.
QUICK_GROUPS = ("quickGroup", "managePresetGroup", "colorManagementGroup")


class WheelGuard(QObject):
    """Stop combo boxes and spin boxes swallowing the scroll wheel.

    Qt sends the wheel to whatever sits under the pointer, so scrolling the
    panel would silently change parameter values.  Unfocused widgets now pass
    the event up to the scroll area instead.
    """

    def eventFilter(self, obj, ev):
        if ev.type() == QEvent.Wheel and not obj.hasFocus():
            ev.ignore()
            return True
        return super().eventFilter(obj, ev)


# ------------------------------------------------------------- render thread


class RenderJob(QThread):
    done = pyqtSignal(object, str)

    def __init__(self, rend, linear, sets):
        super().__init__()
        self.rend, self.linear, self.sets = rend, linear, sets

    def run(self):
        try:
            self.done.emit(self.rend.render(self.linear, self.sets), "")
        except SystemExit as e:
            self.done.emit(None, str(e))
        except Exception as e:  # noqa: BLE001 - surface anything to the status bar
            self.done.emit(None, f"{type(e).__name__}: {e}")


# ------------------------------------------------------------- image display


class ImageView(QLabel):
    def __init__(self):
        super().__init__()
        self.setAlignment(Qt.AlignCenter)
        self.setMinimumSize(QSize(480, 320))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setStyleSheet("background:#121212;border:1px solid #2a2a2a;")
        self.setText("Open a photo to begin")
        self._pm: QPixmap | None = None

    def show_array(self, srgb_u8: np.ndarray | None):
        if srgb_u8 is None:
            self._pm = None
            return
        h, w, _ = srgb_u8.shape
        img = QImage(srgb_u8.tobytes(), w, h, 3 * w, QImage.Format_RGB888)
        self._pm = QPixmap.fromImage(img)
        self._rescale()

    def _rescale(self):
        if self._pm:
            self.setPixmap(self._pm.scaled(self.size(), Qt.KeepAspectRatio,
                                           Qt.SmoothTransformation))

    def resizeEvent(self, e):
        self._rescale()
        super().resizeEvent(e)


# ------------------------------------------------------------------ main window


class Window(QMainWindow):
    def __init__(self, rend: cli.Renderer):
        super().__init__()
        self.rend = rend
        self.settings = QSettings("ofx-photo", "spektra-gui")
        self.setWindowTitle("spektra")
        self.resize(1480, 900)

        self.source_path: Path | None = None
        self.full_linear: np.ndarray | None = None
        self.preview_linear: np.ndarray | None = None
        self.meta: dict = {}
        self.rendered: np.ndarray | None = None   # linear, preview sized
        self.full_render: np.ndarray | None = None
        self.job: RenderJob | None = None
        self.pending = False
        self.showing_original = False
        self.widgets: dict[str, tuple[str, object]] = {}
        self.wheel_guard = WheelGuard()
        self.group_open: dict[str, bool] = {}
        # Only parameters the user actually touched are sent.  Sending them all
        # would re-apply defaults on top of whatever preset was just loaded.
        self.dirty: set[str] = set()
        # Session parameters with no widget in the panel - the panel shows the
        # quick controls, but a session may carry any of the 830.  Keeping them
        # here means importing a session never silently drops settings.
        self.extra_params: dict[str, str] = {}
        self.syncing = False

        self.view = ImageView()
        self._build_ui()
        self._restore()

    # ---- construction

    def _build_ui(self):

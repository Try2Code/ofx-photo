        lay = QHBoxLayout(root)
        lay.setContentsMargins(8, 8, 8, 8)

        left = QVBoxLayout()
        bar = QHBoxLayout()
        b_open = QPushButton("Open…")
        b_open.clicked.connect(self.open_photo)
        self.lbl_file = QLabel("no photo")
        self.lbl_file.setStyleSheet("color:#999;")
        bar.addWidget(b_open)
        bar.addWidget(self.lbl_file, 1)
        b_cmp = QPushButton("Hold to compare")
        b_cmp.pressed.connect(lambda: self._show_original(True))
        b_cmp.released.connect(lambda: self._show_original(False))
        bar.addWidget(b_cmp)
        left.addLayout(bar)
        left.addWidget(self.view, 1)

        out = QHBoxLayout()
        self.b_full = QPushButton("Render full resolution")
        self.b_full.clicked.connect(self.render_full)
        self.b_save = QPushButton("Save image…")
        self.b_save.clicked.connect(self.save_image)
        out.addWidget(self.b_full)
        out.addWidget(self.b_save)
        left.addLayout(out)
        lay.addLayout(left, 1)

        # ---- right hand control panel
        panel = QWidget()
        # Wide enough that long parameter labels and their controls fit without
        # a horizontal scrollbar, which matters most with every parameter shown.
        panel.setMinimumWidth(560)
        pv = QVBoxLayout(panel)

        form = QFormLayout()
        form.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)
        self.cb_category = QComboBox()
        self.cb_preset = QComboBox()
        self.cb_user = QComboBox()
        self.cb_input = QComboBox()
        for w in (self.cb_category, self.cb_preset, self.cb_user, self.cb_input):
            w.setMaxVisibleItems(25)
        form.addRow("Category", self.cb_category)
        form.addRow("Preset", self.cb_preset)
        form.addRow("Yours", self.cb_user)
        form.addRow("Input", self.cb_input)
        pv.addLayout(form)

        row = QHBoxLayout()
        b_save_preset = QPushButton("Save preset…")
        b_save_preset.clicked.connect(self.save_preset)
        b_reset = QPushButton("Reset")
        b_reset.clicked.connect(self.reset_params)
        row.addWidget(b_save_preset)
        row.addWidget(b_reset)
        pv.addLayout(row)

        # Pinning the seed makes a render reproducible, which is what lets the
        # CLI replay an exported session byte for byte.
        seedrow = QHBoxLayout()
        self.chk_seed = QCheckBox("Pin seed")
        self.sp_seed = QSpinBox()
        self.sp_seed.setRange(0, 2147483647)
        self.sp_seed.setValue(7)
        self.chk_seed.toggled.connect(self.on_change)
        self.sp_seed.valueChanged.connect(self.on_change)
        seedrow.addWidget(self.chk_seed)
        seedrow.addWidget(self.sp_seed, 1)
        pv.addLayout(seedrow)

        sessrow = QHBoxLayout()
        b_exp = QPushButton("Export session…")
        b_exp.clicked.connect(self.export_session)
        b_imp = QPushButton("Import session…")
        b_imp.clicked.connect(self.import_session)
        sessrow.addWidget(b_exp)
        sessrow.addWidget(b_imp)
        pv.addLayout(sessrow)

        line = QFrame()
        line.setFrameShape(QFrame.HLine)
        line.setStyleSheet("color:#333;")
        pv.addWidget(line)

        allrow = QHBoxLayout()
        self.chk_all = QCheckBox("Show every parameter (830)")
        self.chk_all.toggled.connect(self.rebuild_params)
        b_expand = QPushButton("Expand all")
        b_collapse = QPushButton("Collapse all")
        b_expand.clicked.connect(lambda: self.set_all_groups(True))
        b_collapse.clicked.connect(lambda: self.set_all_groups(False))
        for b in (b_expand, b_collapse):
            b.setMaximumWidth(110)
        allrow.addWidget(self.chk_all, 1)
        allrow.addWidget(b_expand)
        allrow.addWidget(b_collapse)

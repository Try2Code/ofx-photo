class ImageView(QLabel):
    """The preview, and the crop rectangle drawn over it.

    The whole frame is always shown, with the crop marked on it rather than
    cut out of it.  That matches what the crop means -- a window onto a frame
    rendered in full -- and it keeps the part being discarded visible while
    you choose it.
    """

    cropChanged = pyqtSignal(object)   # dict of fractions, or None

    def __init__(self):
        super().__init__()
        self.setAlignment(Qt.AlignCenter)
        self.setMinimumSize(QSize(480, 320))
        self.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)
        self.setObjectName("imageView")
        self.setText("Open a photo to begin")
        self._pm: QPixmap | None = None
        self.crop: dict | None = None
        self.cropping = False
        self._drag_from: QPoint | None = None
        self._drag_to: QPoint | None = None

    # -- where the scaled pixmap actually sits inside the widget
    def _frame(self) -> QRect | None:
        if not self._pm:
            return None
        size = self._pm.size()
        size.scale(self.size(), Qt.KeepAspectRatio)
        return QRect((self.width() - size.width()) // 2,
                     (self.height() - size.height()) // 2,
                     size.width(), size.height())

    def _to_fraction(self, pos: QPoint) -> tuple[float, float] | None:
        f = self._frame()
        if not f or not f.width() or not f.height():
            return None
        x = min(max((pos.x() - f.x()) / f.width(), 0.0), 1.0)
        y = min(max((pos.y() - f.y()) / f.height(), 0.0), 1.0)
        return x, y

    def set_cropping(self, on: bool):
        self.cropping = on
        self.setCursor(Qt.CrossCursor if on else Qt.ArrowCursor)
        self.update()

    def set_crop(self, crop: dict | None):
        self.crop = crop
        self.update()

    def mousePressEvent(self, ev):
        if not self.cropping or not self._pm:
            return super().mousePressEvent(ev)
        self._drag_from = ev.pos()
        self._drag_to = ev.pos()
        self.update()

    def mouseMoveEvent(self, ev):
        if self._drag_from is None:
            return super().mouseMoveEvent(ev)
        self._drag_to = ev.pos()
        self.update()

    def mouseReleaseEvent(self, ev):
        if self._drag_from is None:
            return super().mouseReleaseEvent(ev)
        a = self._to_fraction(self._drag_from)
        b = self._to_fraction(ev.pos())
        self._drag_from = self._drag_to = None
        if not a or not b:
            return
        x0, x1 = sorted((a[0], b[0]))
        y0, y1 = sorted((a[1], b[1]))
        # A click rather than a drag clears the crop.
        if x1 - x0 < 0.01 or y1 - y0 < 0.01:
            self.crop = None
        else:
            self.crop = {"x": round(x0, 4), "y": round(y0, 4),
                         "w": round(x1 - x0, 4), "h": round(y1 - y0, 4)}
        self.update()
        self.cropChanged.emit(self.crop)

    def paintEvent(self, ev):
        super().paintEvent(ev)
        f = self._frame()
        if not f:
            return
        if self._drag_from is not None and self._drag_to is not None:
            rect = QRect(self._drag_from, self._drag_to).normalized()
        elif self.crop:
            rect = QRect(
                f.x() + int(self.crop["x"] * f.width()),
                f.y() + int(self.crop["y"] * f.height()),
                max(1, int(self.crop["w"] * f.width())),
                max(1, int(self.crop["h"] * f.height())))
        else:
            return

        painter = QPainter(self)
        # Dim what the crop discards, so the kept area reads immediately.
        shade = QColor(0, 0, 0, 120)
        for part in (QRect(f.x(), f.y(), f.width(), rect.y() - f.y()),
                     QRect(f.x(), rect.bottom(), f.width(),
                           f.bottom() - rect.bottom()),
                     QRect(f.x(), rect.y(), rect.x() - f.x(), rect.height()),
                     QRect(rect.right(), rect.y(),
                           f.right() - rect.right(), rect.height())):
            if part.width() > 0 and part.height() > 0:
                painter.fillRect(part, shade)
        painter.setPen(QPen(QColor("#ffcc55"), 2))
        painter.drawRect(rect)
        painter.end()

    def show_array(self, srgb_u8: np.ndarray | None):
        if srgb_u8 is None:
            self._pm = None
            return
        h, w, _ = srgb_u8.shape
        img = QImage(srgb_u8.tobytes(), w, h, 3 * w, QImage.Format_RGB888)
        self._pm = QPixmap.fromImage(img)
        self._rescale()

    def _rescale(self):
        if self._pm:
            self.setPixmap(self._pm.scaled(self.size(), Qt.KeepAspectRatio,
                                           Qt.SmoothTransformation))

    def resizeEvent(self, e):
        self._rescale()
        super().resizeEvent(e)



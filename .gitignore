# Build output
build/
*.o
*.so
compile_commands.json

# Interchange + scratch renders
*.sfraw
out/
scratch/

# Never commit the plugin itself: it is the vendor's to distribute, and its
# resources exceed GitHub's 100 MB file limit.  Point the tools at an installed
# copy with --bundle instead.
*.ofx.bundle/
*.ofx
*.f32
*.spv

# Python
__pycache__/
*.pyc
venv/
.venv/

# Editors
.vscode/
.idea/
*.swp

# Test photographs live here but belong to their owner, not the repo.
*.jpg
*.JPG
*.jpeg
*.JPEG
*.png
*.tif
*.tiff
*.ppm
*.NEF
*.CR2
*.CR3
*.ARW
*.DNG
*.RAF
*.RW2
*.ORF
spektra-session*.json

# ...except images that are part of the project rather than test material:
# the shipped icons, which CMake installs, and the documentation screenshots.
!desktop/icons/
!desktop/icons/**/*.png
!docs/
!docs/*.jpg
!docs/*.png

# The upstream research project, cloned here for reference only.
spektrafilm/
RawTherapee/

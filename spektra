# --------------------------------------------------------------- locating bits


def find_renderer() -> Path:
    for c in (HERE / "build" / "spektra-render", HERE / "spektra-render"):
        if c.is_file() and os.access(c, os.X_OK):
            return c
    found = shutil.which("spektra-render")
    if found:
        return Path(found)
    sys.exit("spektra: spektra-render not built - run: cmake -S . -B build && cmake --build build")


# Short names for the plugin family.  They are one engine with different
# defaults, so these are conveniences, not different effects.
BUNDLE_ALIASES = {
    "film": "spektrafilm",
    "spektrafilm": "spektrafilm",
    "lens": "spektrafilm_lens",
    "diffuse": "spektrafilm_diffuse",
    "flow": "spektrafilm_flow",
}


def bundle_roots() -> list[Path]:
    roots = [Path("/usr/OFX/Plugins"), Path.home() / "OFX" / "Plugins"]
    roots += [Path(p) for p in os.environ.get("OFX_PLUGIN_PATH", "").split(":") if p]
    roots.append(HERE.parent)  # an unpacked download sits beside this checkout
    return roots


def find_bundle(explicit: str | None) -> Path:
    """Resolve a path, a short name like 'lens', or the default bundle."""
    wanted = "spektrafilm"
    if explicit:
        p = Path(explicit).expanduser()
        if p.exists():
            return p
        key = explicit.lower().removesuffix(".ofx.bundle")
        if key not in BUNDLE_ALIASES and not key.startswith("spektrafilm"):
            sys.exit(f"spektra: no such bundle: {explicit}\n"
                     f"Try a path, or one of: {', '.join(sorted(BUNDLE_ALIASES))}")
        wanted = BUNDLE_ALIASES.get(key, key)

    for root in bundle_roots():
        if not root.is_dir():
            continue
        cand = root / f"{wanted}.ofx.bundle"
        if cand.is_dir():
            return cand
    sys.exit(
        f"spektra: could not find {wanted}.ofx.bundle.\n"
        "Install the plugin, set OFX_PLUGIN_PATH, or pass --bundle PATH."
    )


_renderers: dict[str, "Renderer"] = {}


def renderer_for(bundle: str | None) -> "Renderer":
    """One Renderer per bundle, reused across passes and images."""
    path = str(find_bundle(bundle))
    if path not in _renderers:
        _renderers[path] = Renderer(find_renderer(), Path(path))
    return _renderers[path]


# ------------------------------------------------------------------ sfraw I/O


def sfraw_write(path: Path, rgba: np.ndarray) -> None:
    h, w, c = rgba.shape
    with open(path, "wb") as f:
        f.write(b"SFRW")
        f.write(struct.pack("<III", w, h, c))
        # OFX scanlines run bottom-up.
        f.write(np.ascontiguousarray(rgba[::-1], dtype="<f4").tobytes())


def sfraw_read(path: Path) -> np.ndarray:
    with open(path, "rb") as f:
        if f.read(4) != b"SFRW":
            sys.exit(f"spektra: {path} is not an sfraw file")
        w, h, c = struct.unpack("<III", f.read(12))
        a = np.frombuffer(f.read(w * h * c * 4), dtype="<f4").reshape(h, w, c)
    return a[::-1].copy()


# -------------------------------------------------------------- colour & I/O


def srgb_to_linear(x: np.ndarray) -> np.ndarray:
    return np.where(x <= 0.04045, x / 12.92, ((x + 0.055) / 1.055) ** 2.4)


def linear_to_srgb(x: np.ndarray) -> np.ndarray:
    x = np.clip(x, 0.0, 1.0)
    return np.where(x <= 0.0031308, x * 12.92, 1.055 * x ** (1 / 2.4) - 0.055)


def load_photo(path: Path, raw_linear: bool = True) -> tuple[np.ndarray, str, dict]:
    """Return (linear RGBA float32, colourspace name for the plugin, metadata)."""
    meta: dict = {}
    if path.suffix.lower() in RAW_SUFFIXES:
        rgb = load_raw(path)
        # dcraw -4 gives linear scene data with sRGB/Rec.709 primaries.
        return rgb, "Linear Rec.709", meta

    deep = read_deep_tiff(path)
    if deep is not None:
        return srgb_to_linear(deep).astype(np.float32), "Linear Rec.709", meta

    im = Image.open(path)
    meta["exif"] = im.info.get("exif")
    meta["icc"] = im.info.get("icc_profile")
    im = apply_orientation(im)
    im, meta["colour_note"] = to_srgb_profile(im, meta["icc"])
    if im.mode not in ("RGB", "RGBA", "L", "I;16", "I"):
        im = im.convert("RGB")
    a = np.asarray(im)
    if a.dtype == np.uint8:
        a = a.astype(np.float32) / 255.0
    elif a.dtype == np.uint16:
        a = a.astype(np.float32) / 65535.0
    else:
        a = a.astype(np.float32)
        if a.max() > 1.0:
            a /= a.max()
    if a.ndim == 2:
        a = np.stack([a] * 3, -1)
    if a.shape[2] == 4:
        a = a[..., :3]
    return srgb_to_linear(a).astype(np.float32), "Linear Rec.709", meta


def read_deep_tiff(path: Path) -> np.ndarray | None:
    """Read a 16-bit RGB TIFF at full precision, or return None.

    Pillow truncates 16-bit RGB TIFFs to 8 bits.  Brightness survives, because
    the caller scales by dtype, but half the tonal range does not.  Route those
    through ImageMagick when it is available; otherwise fall back to Pillow,
    which is merely less precise, not wrong.
    """
    if path.suffix.lower() not in (".tif", ".tiff"):
        return None
    try:
        with open(path, "rb") as f:
            if f.read(4) not in (b"II*\x00", b"MM\x00*"):
                return None
        if np.asarray(Image.open(path)).dtype != np.uint8:
            return None  # Pillow already read it at full depth
    except Exception:
        return None

    convert = shutil.which("convert") or shutil.which("magick")
    if not convert:
        return None
    r = subprocess.run([convert, str(path), "-depth", "16", "ppm:-"],
                       capture_output=True)
    if r.returncode != 0 or not r.stdout.startswith(b"P6"):
        return None
    with tempfile.NamedTemporaryFile(suffix=".ppm", delete=True) as tf:
        tf.write(r.stdout)
        tf.flush()
        return read_ppm16(Path(tf.name))


def to_srgb_profile(im: "Image.Image", icc: bytes | None) -> tuple["Image.Image", str]:
    """Convert an embedded ICC profile to sRGB.

    Everything downstream assumes sRGB primaries.  A file exported as Adobe RGB
    or ProPhoto would otherwise be decoded as if it were sRGB, which shifts
    every colour.  Files that are already sRGB, and files with no profile, are
    left untouched.
    """
    if not icc:
        return im, "no ICC profile, assumed sRGB"
    try:
        import io

        from PIL import ImageCms

        src = ImageCms.ImageCmsProfile(io.BytesIO(icc))
        name = (ImageCms.getProfileDescription(src) or "").strip()
        if "srgb" in name.lower().replace(" ", ""):
            return im, f"ICC {name!r}, already sRGB"
        if im.mode not in ("RGB", "RGBA"):
            im = im.convert("RGB")
        converted = ImageCms.profileToProfile(
            im, src, ImageCms.createProfile("sRGB"), outputMode=im.mode)
        if converted is not None:
            return converted, f"ICC {name!r} converted to sRGB"
        return im, f"ICC {name!r} could not be converted, assumed sRGB"
    except Exception as e:  # a broken profile must not stop the render
        return im, f"ICC profile unreadable ({type(e).__name__}), assumed sRGB"


def describe_image(path: Path) -> dict:
    """Metadata worth seeing when a render looks wrong."""
    from PIL import ExifTags

    info: dict = {"file": str(path), "bytes": path.stat().st_size}
    if path.suffix.lower() in RAW_SUFFIXES:
        info["kind"] = "camera raw"
    try:
        im = Image.open(path)
        info.update(kind=info.get("kind", im.format), size=list(im.size), mode=im.mode)
        ex = im.getexif()
        tags = {ExifTags.TAGS.get(k, k): v for k, v in ex.items()}
        tags.update({ExifTags.TAGS.get(k, k): v
                     for k, v in ex.get_ifd(0x8769).items()})
        keep = ("Make", "Model", "LensModel", "DateTimeOriginal", "Orientation",
                "ColorSpace", "ISOSpeedRatings", "ExposureTime", "FNumber",
                "FocalLength", "WhiteBalance", "ExposureBiasValue")
        info["exif"] = {k: str(tags[k]) for k in keep if k in tags}
        icc = im.info.get("icc_profile")
        info["icc_bytes"] = len(icc) if icc else 0
    except Exception as e:
        info["error"] = f"{type(e).__name__}: {e}"

    try:
        a, cs, meta = load_photo(path)
        info["decoded"] = {
            "shape": list(a.shape),
            "colourspace_for_plugin": cs,
            "linear_mean": round(float(a.mean()), 6),
            "linear_median": round(float(np.median(a)), 6),
            "linear_p99": round(float(np.percentile(a, 99)), 6),
            "linear_max": round(float(a.max()), 6),
            "note": meta.get("colour_note", ""),
        }
    except SystemExit as e:
        info["decoded"] = {"error": str(e)}
    return info


def apply_orientation(im: "Image.Image") -> "Image.Image":
    try:
        from PIL import ImageOps

        return ImageOps.exif_transpose(im)
    except Exception:
        return im


def read_ppm16(path: Path) -> np.ndarray:
    """Read a binary PPM as uint16.

    Pillow silently truncates 16-bit RGB to 8 bits, keeping only the high byte,
    which loses a factor of 256 and leaves raw files looking almost black.  PPM
    is trivial to parse, so parse it.
    """
    with open(path, "rb") as f:
        data = f.read()

    fields, pos = [], 0
    while len(fields) < 4:
        while pos < len(data) and data[pos : pos + 1].isspace():
            pos += 1
        if data[pos : pos + 1] == b"#":  # comment runs to end of line
            while pos < len(data) and data[pos : pos + 1] not in (b"\n", b"\r"):
                pos += 1
            continue
        start = pos
        while pos < len(data) and not data[pos : pos + 1].isspace():
            pos += 1
        fields.append(data[start:pos])
    magic, w, h, maxval = fields[0], int(fields[1]), int(fields[2]), int(fields[3])
    if magic != b"P6":
        sys.exit(f"spektra: {path} is not a binary PPM")
    pos += 1  # exactly one whitespace byte separates header from data

    dtype = ">u2" if maxval > 255 else "u1"
    a = np.frombuffer(data, dtype=dtype, count=w * h * 3, offset=pos)
    return a.reshape(h, w, 3).astype(np.float32) / float(maxval)


def load_raw(path: Path) -> np.ndarray:
    """Decode a camera raw file to scene-linear RGB via dcraw_emu (libraw-bin)."""
    exe = shutil.which("dcraw_emu") or shutil.which("dcraw")
    if not exe:
        sys.exit(
            f"spektra: {path.name} is a camera raw file and needs a decoder.\n"
            "Install it with:  sudo apt install libraw-bin"
        )
    with tempfile.TemporaryDirectory() as td:
        work = Path(td) / path.name
        shutil.copy2(path, work)
        # -4 linear 16-bit, -o 1 sRGB primaries, -w camera white balance.
        # PPM rather than TIFF, so the 16 bits survive the read.
        r = subprocess.run([exe, "-4", "-o", "1", "-w", str(work)], capture_output=True)
        if r.returncode != 0:
            sys.exit(f"spektra: raw decode failed for {path.name}:\n{r.stderr.decode()[:400]}")
        out = list(Path(td).glob("*.ppm")) + list(Path(td).glob("*.ppm"))
        if not out:
            sys.exit(f"spektra: raw decoder produced no output for {path.name}")
        return read_ppm16(out[0])


def write_ppm16(path: Path, srgb: np.ndarray) -> None:
    h, w = srgb.shape[:2]
    arr = np.clip(srgb * 65535.0 + 0.5, 0, 65535).astype(">u2")
    with open(path, "wb") as f:
        f.write(b"P6\n%d %d\n65535\n" % (w, h))
        f.write(arr[..., :3].tobytes())


def save_deep(path: Path, srgb: np.ndarray) -> bool:
    """Write a true 16-bit PNG or TIFF.  False if we could not.

    Pillow cannot write 16-bit RGB: handing it a uint16 array with mode="RGB"
    silently produces an 8-bit file.  Go through PPM and ImageMagick instead.
    """
    convert = shutil.which("convert") or shutil.which("magick")
    if not convert:
        return False
    with tempfile.TemporaryDirectory() as td:
        ppm = Path(td) / "out.ppm"
        write_ppm16(ppm, srgb)
        r = subprocess.run([convert, str(ppm), "-depth", "16", str(path)],
                           capture_output=True)
        return r.returncode == 0 and path.exists()


def save_photo(path: Path, display_rgb: np.ndarray, bit_depth: int, quality: int,
               meta: dict) -> None:
    """Write pixels the plugin has already encoded for display.

    The plugin applies its own output transform, so what comes back is sRGB
    already.  Encoding it again lifted shadows by up to 70 levels out of 255.
    """
    srgb = np.clip(display_rgb[..., :3], 0.0, 1.0)
    ext = path.suffix.lower()
    if bit_depth == 16 and ext in (".tif", ".tiff", ".png"):
        if save_deep(path, srgb):
            return
        print(f"spektra: cannot write 16-bit without ImageMagick; "
              f"writing {path.name} at 8-bit", file=sys.stderr)
    arr = np.clip(srgb * 255.0 + 0.5, 0, 255).astype(np.uint8)
    im = Image.fromarray(arr)
    kw: dict = {}
    if ext in (".jpg", ".jpeg"):
        kw.update(quality=quality, subsampling=0)
        if meta.get("exif"):
            kw["exif"] = meta["exif"]
    im.save(path, **kw)


# ------------------------------------------------------------ the render call


class Renderer:
    def __init__(self, renderer: Path, bundle: Path):
        self.renderer, self.bundle = renderer, bundle
        self._params: list[dict] | None = None

    def describe(self, sets: list[tuple[str, str]] | None = None) -> list[dict]:
        cmd = [str(self.renderer), "--bundle", str(self.bundle), "--list-params"]
        for k, v in sets or []:
            cmd += ["--set", f"{k}={v}"]
        r = subprocess.run(cmd, capture_output=True)
        if r.returncode != 0:
            sys.exit(f"spektra: {r.stderr.decode().strip()}")
        return json.loads(r.stdout)

    @property
    def params(self) -> list[dict]:
        if self._params is None:
            self._params = self.describe()
        return self._params

    def by_name(self, sets=None) -> dict[str, dict]:
        return {p["name"]: p for p in (self.describe(sets) if sets else self.params)}

    def render(self, linear_rgb: np.ndarray, sets: list[tuple[str, str]]) -> np.ndarray:
        h, w = linear_rgb.shape[:2]
        rgba = np.ones((h, w, 4), np.float32)
        rgba[..., :3] = linear_rgb[..., :3]
        with tempfile.TemporaryDirectory() as td:
            src, dst = Path(td) / "in.sfraw", Path(td) / "out.sfraw"
            sfraw_write(src, rgba)
            cmd = [str(self.renderer), "--bundle", str(self.bundle)]
            for k, v in sets:
                cmd += ["--set", f"{k}={v}"]
            cmd += ["--in", str(src), "--out", str(dst)]
            r = subprocess.run(cmd, capture_output=True)
            if r.returncode != 0:
                sys.exit(f"spektra: {r.stderr.decode().strip()}")
            return sfraw_read(dst)


# -------------------------------------------------------------------- session
#
# A session is the whole of what the GUI holds, as JSON.  The GUI can export
# one and the CLI can replay it exactly, so the internals can be exercised
# without driving the window.

SESSION_VERSION = 1

# Seeds are randomised for each new plugin instance, so two runs of the same
# settings differ slightly.  Deriving them all from one integer makes a render
# byte-for-byte reproducible, which is what automated comparison needs.
SEED_PARAMS = {
    "grainSeed": 1000000,
    "technicolorGrainSeed": 2147483647,
    "gateWeaveSeed": 2147483647,
    "timingShiftSeed": 2147483647,
    "flickerSeed": 2147483647,
    "dustHairsSeed": 2147483647,
    "glareSeed": 2147483647,
}


def default_session() -> dict:
    return {
        "version": SESSION_VERSION,
        "input": None,
        "output": None,
        "bundle": None,
        "preset": {"category": None, "selection": None},
        "user_preset": None,
        "input_colorspace": "Linear Rec.709",
        "output_colorspace": "sRGB",
        "params": {},
        "seed": None,
        "chain": [],
        "preview": None,
        "output_options": {"bit_depth": 8, "quality": 95},
    }


def seed_sets(seed) -> list[tuple[str, str]]:
    if seed is None:
        return []
    rng = random.Random(int(seed))
    return [(n, str(rng.randrange(0, lim))) for n, lim in SEED_PARAMS.items()]


def load_session(spec: str) -> dict:
    """Accept a path, a literal JSON string, or - for stdin."""
    if spec == "-":
        text = sys.stdin.read()
    elif spec.lstrip().startswith("{"):
        text = spec
    else:
        text = Path(spec).expanduser().read_text()
    try:
        raw = json.loads(text)
    except json.JSONDecodeError as e:
        sys.exit(f"spektra: session is not valid JSON: {e}")
    if not isinstance(raw, dict):
        sys.exit("spektra: a session must be a JSON object")
    if raw.get("version", SESSION_VERSION) > SESSION_VERSION:
        sys.exit(f"spektra: session version {raw['version']} is newer than this tool")

    s = default_session()
    for k, v in raw.items():
        if isinstance(v, dict) and isinstance(s.get(k), dict):
            s[k].update(v)
        else:
            s[k] = v
    return s


def session_to_sets(session: dict) -> list[tuple[str, str]]:
    """Turn a session into the ordered parameter list the host wants."""
    sets: list[tuple[str, str]] = []
    preset = session.get("preset") or {}
    if preset.get("category"):
        sets.append((P_CATEGORY, str(preset["category"])))
    if preset.get("selection"):
        sets.append((P_SELECTION, str(preset["selection"])))
    if session.get("user_preset"):
        sets += [(P_USER_PRESET, str(session["user_preset"])), (P_LOAD, "")]
    # After the preset, so explicit settings always win over it.
    if session.get("input_colorspace"):
        sets.append((P_INPUT_CS, str(session["input_colorspace"])))
    # The plugin returns display-encoded pixels, not linear ones.  Pin the
    # encoding so the writer knows exactly what it is being handed.
    if session.get("output_colorspace"):
        sets.append((P_OUTPUT_CS, str(session["output_colorspace"])))
    sets += seed_sets(session.get("seed"))
    for name, value in (session.get("params") or {}).items():
        sets.append((str(name), str(value)))
    return sets


def resize_linear(a: np.ndarray, long_edge: int) -> np.ndarray:
    """Downscale linear float data, as the GUI preview does.

    Each channel is resampled on its own in float mode: Pillow cannot hold
    16-bit RGB, and rounding to 8 bits would throw away tonal range.
    """
    h, w = a.shape[:2]
    scale = min(1.0, long_edge / max(h, w))
    if scale >= 1.0:
        return a
    nw, nh = max(1, int(w * scale)), max(1, int(h * scale))
    out = np.empty((nh, nw, a.shape[2]), np.float32)
    for c in range(a.shape[2]):
        im = Image.fromarray(a[..., c].astype(np.float32), mode="F")
        out[..., c] = np.asarray(im.resize((nw, nh), Image.LANCZOS), np.float32)
    return out


# ---------------------------------------------------------------- preset logic


def norm(s: str) -> str:
    return "".join(ch for ch in s.lower() if ch.isalnum())


def resolve_preset(rend: Renderer, wanted: str) -> list[tuple[str, str]]:
    """Find a bundled preset by name, across every category."""
    cats = rend.by_name()[P_CATEGORY]["choices"]
    everything: list[tuple[str, str]] = []
    for cat in cats:
        for name in rend.by_name([(P_CATEGORY, cat)])[P_SELECTION]["choices"]:
            everything.append((cat, name))

    for cat, name in everything:
        if norm(name) == norm(wanted):
            return [(P_CATEGORY, cat), (P_SELECTION, name)]

    names = [n for _, n in everything]
    close = difflib.get_close_matches(wanted, names, n=5, cutoff=0.4)
    hint = "\n  ".join(close) if close else "\n  ".join(names[:12])
    sys.exit(f"spektra: no preset called {wanted!r}. Did you mean:\n  {hint}")


def list_presets(rend: Renderer) -> None:
    for cat in rend.by_name()[P_CATEGORY]["choices"]:
        names = rend.by_name([(P_CATEGORY, cat)])[P_SELECTION]["choices"]
        print(f"\n{cat}  ({len(names)})")
        for n in names:
            print(f"  {n}")
    user = rend.by_name()[P_USER_PRESET]["choices"]
    if user and user != ["No presets found"]:
        print(f"\nYour saved presets  ({len(user)})")
        for n in user:
            print(f"  {n}")


# ----------------------------------------------------------------------- main


def session_from_args(args, rend: Renderer) -> dict:
    """Build a session from the command line, starting from --session if given."""
    s = load_session(args.session) if args.session else default_session()

    if args.bundle:
        s["bundle"] = str(args.bundle)
    if args.preset:
        cat, sel = resolve_preset(rend, args.preset)
        s["preset"] = {"category": cat[1], "selection": sel[1]}
    if args.user_preset:
        s["user_preset"] = args.user_preset
    if args.input_colorspace:
        s["input_colorspace"] = args.input_colorspace
    if args.seed is not None:
        s["seed"] = args.seed
    if args.preview is not None:
        s["preview"] = {"long_edge": args.preview}
    for kv in args.set or []:
        if "=" not in kv:
            sys.exit(f"spektra: --set wants NAME=VALUE, got {kv!r}")
        k, v = kv.split("=", 1)
        s["params"][k] = v
    for spec in args.chain or []:
        name, _, preset = spec.partition(":")
        step: dict = {"bundle": name.strip(), "params": {}}
        if preset.strip():
            r2 = renderer_for(name.strip())
            cat, sel = resolve_preset(r2, preset.strip())
            step["preset"] = {"category": cat[1], "selection": sel[1]}
        s["chain"].append(step)
    if args.bit_depth is not None:
        s["output_options"]["bit_depth"] = args.bit_depth
    if args.quality is not None:
        s["output_options"]["quality"] = args.quality
    return s


def render_pipeline(session: dict, linear: np.ndarray,
                    rend: Renderer | None = None) -> np.ndarray:
    """Run the first pass and any chained ones.  Shared by the CLI and the GUI."""
    rend = rend or renderer_for(session.get("bundle"))
    out = rend.render(linear, session_to_sets(session))

    # Extra passes run on the previous pass's output.  That output is display
    # encoded, so each pass reads in the encoding the one before it wrote.
    previous_out = session.get("output_colorspace") or "sRGB"
    for step in session.get("chain") or []:
        p = dict(step)
        p.setdefault("input_colorspace", previous_out)
        p.setdefault("output_colorspace", "sRGB")
        p.setdefault("seed", session.get("seed"))
        out = renderer_for(p.get("bundle")).render(out, session_to_sets(p))
        previous_out = p["output_colorspace"]
    return out


def render_session(rend: Renderer, session: dict, src: Path) -> tuple[np.ndarray, dict]:
    linear, cs, meta = load_photo(src)
    if not session.get("input_colorspace"):
        session["input_colorspace"] = cs
    preview = session.get("preview") or {}
    if preview.get("long_edge"):
        linear = resize_linear(linear, int(preview["long_edge"]))
    return render_pipeline(session, linear, rend), meta


def process_one(rend: Renderer, src: Path, dst: Path, session: dict,
                save_preset: str | None = None) -> str:
    s = copy.deepcopy(session)
    out, meta = render_session(rend, s, src)
    if save_preset:
        rend.describe(session_to_sets(s) + [(P_PRESET_NAME, save_preset), (P_SAVE, "")])
    opts = s.get("output_options") or {}
    save_photo(dst, out, int(opts.get("bit_depth", 8)), int(opts.get("quality", 95)), meta)
    return f"{src.name} -> {dst}"


def main() -> None:
    ap = argparse.ArgumentParser(
        prog="spektra",
        description="Apply an OFX film-emulation plugin to photographs.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""examples:
  spektra photo.jpg out.jpg --preset "Marty - Warm"
  spektra photo.NEF out.tif --preset "CineStill 800T" --bit-depth 16
  spektra photo.jpg out.jpg --set exposure=0.3
  spektra --list-presets
  spektra --list-params --grep grain
  spektra shots/*.NEF outdir/ --preset "Vintage Faded"

  # reproducible renders, and sessions shared with the GUI
  spektra photo.jpg out.jpg --preset "OIL!" --seed 7 --preview
  spektra photo.jpg out.jpg --preset "OIL!" --dump-session look.json
  spektra --session look.json
  spektra --session '{"input":"a.jpg","output":"b.jpg","seed":7}'

  # the companion plugins: extra passes over the first result
  spektra photo.jpg out.jpg --preset "Marty - Warm" --chain lens
  spektra photo.jpg out.jpg --chain "diffuse:Clean Slate" --chain lens
  spektra photo.jpg out.jpg --bundle diffuse --preset "OIL!"
""",
    )
    ap.add_argument("inputs", nargs="*", type=Path)
    ap.add_argument("output", nargs="?", type=Path)
    ap.add_argument("--bundle", help="path to the .ofx.bundle")
    ap.add_argument("--preset", help="a bundled preset, by name")
    ap.add_argument("--user-preset", help="one of your own saved presets")
    ap.add_argument("--save-preset", metavar="NAME",
                    help="save these settings as a preset of your own")
    ap.add_argument("--set", action="append", metavar="NAME=VALUE",
                    help="set any plugin parameter (repeatable)")
    ap.add_argument("--input-colorspace", help="override the input colourspace")
    ap.add_argument("--bit-depth", type=int, default=None, choices=(8, 16))
    ap.add_argument("--quality", type=int, default=None, help="JPEG quality")
    ap.add_argument("--session", metavar="SPEC",
                    help="load a session: a path, a literal JSON object, or - for stdin")
    ap.add_argument("--dump-session", nargs="?", const="-", metavar="PATH",
                    help="write the resolved session as JSON and exit (default stdout)")
    ap.add_argument("--chain", action="append", metavar="BUNDLE[:PRESET]",
                    help="run another pass after the first, e.g. --chain lens "
                         "or --chain 'diffuse:Clean Slate' (repeatable)")
    ap.add_argument("--seed", type=int, metavar="N",
                    help="pin every random seed, making the render reproducible")
    ap.add_argument("--preview", nargs="?", type=int, const=1100, metavar="PX",
                    help="render at the GUI preview size (default 1100 px long edge)")
    ap.add_argument("--jobs", type=int, default=1, help="parallel images")
    ap.add_argument("--info", action="store_true",
                    help="report metadata and decoded statistics, then exit")
    ap.add_argument("--list-presets", action="store_true")
    ap.add_argument("--list-params", action="store_true")
    ap.add_argument("--grep", metavar="TEXT", help="filter --list-params")
    args = ap.parse_args()

    pre = load_session(args.session) if args.session else {}
    rend = renderer_for(args.bundle or pre.get("bundle"))

    if args.info:
        if not args.inputs:
            ap.error("--info needs at least one image")
        paths = list(args.inputs) + ([args.output] if args.output else [])
        print(json.dumps([describe_image(p) for p in paths], indent=2))
        return

    if args.list_presets:
        list_presets(rend)
        return

    if args.list_params:
        for p in rend.params:
            blob = f"{p['name']} {p['label']} {p.get('hint','')}"
            if args.grep and args.grep.lower() not in blob.lower():
                continue
            kind = p["type"].replace("OfxParamType", "")
            print(f"{p['name']:34} {kind:11} {p['label']}")
            if p.get("choices"):
                print(f"{'':34} options: {', '.join(p['choices'][:8])}"
                      + (f" ... (+{len(p['choices'])-8})" if len(p["choices"]) > 8 else ""))
            elif kind == "Boolean":
                print(f"{'':34} on/off, now {'on' if p['value'][0] else 'off'}")
            elif kind in ("Group", "PushButton"):
                pass
            elif "min" in p:
                print(f"{'':34} range {p['min']} .. {p['max']}   now {p['value']}")
        return

    session = session_from_args(args, rend)

    # Positional handling: the last path is the destination.
    paths = list(args.inputs) + ([args.output] if args.output else [])
    if not paths and session.get("input"):
        paths = [Path(session["input"])]
        if session.get("output"):
            paths.append(Path(session["output"]))

    if args.dump_session is not None:
        if paths:
            session["input"] = str(paths[0])
            if len(paths) > 1:
                session["output"] = str(paths[-1])
        session["bundle"] = session.get("bundle") or str(rend.bundle)
        text = json.dumps(session, indent=2)
        if args.dump_session == "-":
            print(text)
        else:
            Path(args.dump_session).write_text(text + "\n")
            print(f"session -> {args.dump_session}", file=sys.stderr)
        return

    if len(paths) < 2:
        ap.error("need an input and an output")
    *sources, target = paths

    if len(sources) > 1 or target.is_dir():
        target.mkdir(parents=True, exist_ok=True)
        jobs = [(s, target / (s.stem + "_spektra" + (s.suffix if s.suffix.lower()
                not in RAW_SUFFIXES else ".jpg"))) for s in sources]
    else:
        jobs = [(sources[0], target)]

    if args.jobs > 1 and len(jobs) > 1:
        with ThreadPoolExecutor(max_workers=args.jobs) as ex:
            for line in ex.map(lambda j: process_one(rend, j[0], j[1], session), jobs):
                print(line)
    else:
        for s, d in jobs:
            print(process_one(rend, s, d, session, args.save_preset))


if __name__ == "__main__":
    main()

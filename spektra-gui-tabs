#!/usr/bin/env python3
"""spektra-gui-tabs - the same GUI, with the controls split across five tabs.

An experiment: the upstream spektrafilm research GUI is a napari dock whose
controls sit in five tabs (MAIN, FILM, PRINT, ADVANCED, CONFIG), each holding
collapsible sections.  Ours puts every group in one scrolling column.

This variant changes *only* the arrangement of the parameter panel.  It
subclasses the real window, so the preview, presets, sessions, passes, theme
and rendering are the same code -- whatever you prefer here is about layout,
not about anything else having changed.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

# Loading the sibling script as a module would otherwise litter __pycache__
# next to the installed programs.
sys.dont_write_bytecode = True

_spec = importlib.util.spec_from_loader(
    "spektra_gui", importlib.machinery.SourceFileLoader("spektra_gui", str(HERE / "spektra-gui")))
base = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(base)

from PyQt5.QtCore import Qt  # noqa: E402
from PyQt5.QtWidgets import (  # noqa: E402
    QApplication, QComboBox, QFormLayout, QLabel, QScrollArea, QSizePolicy,
    QTabWidget, QToolButton, QVBoxLayout, QWidget,
)

cli = base.cli

# The plugin's own groups, dealt into the upstream GUI's five tabs.  Its
# parameter set is wider than the research project's -- all the lens and
# film-damage work has no counterpart there -- so that lot goes under ADVANCED
# rather than inventing a sixth tab.
TABS: list[tuple[str, tuple[str, ...]]] = [
    ("MAIN", (
        "quickAccessGroup", "colorGroup", "filmGroup", "scannerGroup",
        "dirGammaGroup", "infoGroup",
    )),
    ("FILM", (
        "grainGroup", "halationGroup", "diffusionGroup", "couplerGroup",
        "dirSharpeningGroup", "advancedFilmChemistryGroup", "filteringGroup",
        "filmPlaneGroup",
    )),
    ("PRINT", (
        "printGroup", "advancedPrintChemistryGroup", "illuminantTransferGroup",
    )),
    ("ADVANCED", (
        "tetraGroup", "tetraProtectionsGroup", "colorAdaptationGroup",
        "effectsGroup", "lensDistortionGroup", "vignetteGroup", "bokehGroup",
        "comaGroup", "chromaticAberrationGroup", "filmGateGroup",
        "gateWeaveGroup", "flickerBreathingGroup", "timingShiftGroup",
    )),
    ("CONFIG", (
        "managePresetGroup", "manageLutGroup", "manageGroup",
        "manageBackendGroup",
    )),
]


class TabbedWindow(base.Window):
    """The same window, with the parameter panel dealt into tabs."""

    def rebuild_params(self):
        while self.param_layout.count():
            item = self.param_layout.takeAt(0)
            w = item.widget()
            if w:
                w.setParent(None)
                w.deleteLater()
        self.widgets.clear()

        params = self.rend.params
        groups = {p["name"]: p["label"] for p in params if p["type"] == "OfxParamTypeGroup"}
        show_all = self.chk_all.isChecked()

        sections: dict[str, list[dict]] = {}
        for p in params:
            if p["type"] in ("OfxParamTypeGroup", "OfxParamTypePushButton"):
                continue
            if p.get("secret"):
                continue
            if not show_all and not (p["name"].startswith("quick")
                                     or p.get("parent") in base.DEFAULT_GROUPS):
                continue
            if p["name"] in (cli.P_CATEGORY, cli.P_SELECTION, cli.P_USER_PRESET,
                             cli.P_INPUT_CS, cli.P_PRESET_NAME, cli.P_OUTPUT_CS):
                continue
            if p["name"] in base.PIPELINE_OWNED:
                continue
            sections.setdefault(p.get("parent") or "", []).append(p)

        tabs = QTabWidget()
        tabs.setObjectName("controlsTabWidget")
        tabs.setDocumentMode(True)
        tabs.setUsesScrollButtons(False)
        tabs.tabBar().setDrawBase(False)

        placed: set[str] = set()
        for title, members in TABS:
            present = [g for g in members if sections.get(g)]
            placed.update(present)
            tabs.addTab(self._build_tab(present, sections, groups, show_all),
                        f"{title}" if not present else f"{title}")
            tabs.setTabEnabled(tabs.count() - 1, bool(present))

        # Anything the map does not mention still has to appear somewhere.
        leftover = [g for g in sections if g not in placed]
        if leftover:
            tabs.addTab(self._build_tab(leftover, sections, groups, show_all), "OTHER")

        self.param_layout.addWidget(tabs)
        if self.widgets:
            self.sync_widgets()

    def _build_tab(self, group_names, sections, groups, show_all) -> QWidget:
        """One tab: a scrolling column of collapsible sections."""
        inner = QWidget()
        column = QVBoxLayout(inner)
        column.setAlignment(Qt.AlignTop)
        column.setContentsMargins(4, 4, 4, 4)

        if not group_names:
            hint = QLabel("Nothing here until “Show every parameter” is ticked.")
            hint.setWordWrap(True)
            hint.setObjectName("muted")
            column.addWidget(hint)

        for parent in group_names:
            items = sections.get(parent) or []
            title = groups.get(parent, parent or "General")

            head = QToolButton()
            head.setText(f"{title}  ({len(items)})")
            head.setCheckable(True)
            head.setToolButtonStyle(Qt.ToolButtonTextBesideIcon)
            head.setObjectName("groupHead")
            head.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            column.addWidget(head)

            holder = QWidget()
            form = QFormLayout(holder)
            form.setContentsMargins(4, 0, 0, 0)
            form.setFieldGrowthPolicy(QFormLayout.AllNonFixedFieldsGrow)
            form.setRowWrapPolicy(QFormLayout.WrapLongRows)
            form.setLabelAlignment(Qt.AlignLeft)
            column.addWidget(holder)

            # Within a tab there are few enough groups to open them by default.
            open_now = self.group_open.get(parent, not show_all or len(group_names) <= 6)
            head.setChecked(open_now)
            holder.setVisible(open_now)
            head.setArrowType(Qt.DownArrow if open_now else Qt.RightArrow)

            def toggled(on, h=holder, b=head, key=parent):
                h.setVisible(on)
                b.setArrowType(Qt.DownArrow if on else Qt.RightArrow)
                self.group_open[key] = on

            head.toggled.connect(toggled)

            for p in items:
                w = self._widget_for(p)
                if w is None:
                    continue
                w.setFocusPolicy(Qt.StrongFocus)
                w.installEventFilter(self.wheel_guard)
                w.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
                if isinstance(w, QComboBox):
                    w.setSizeAdjustPolicy(QComboBox.AdjustToMinimumContentsLengthWithIcon)
                    w.setMinimumContentsLength(12)
                label = QLabel(p["label"])
                label.setWordWrap(True)
                form.addRow(label, w)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setFrameShape(QScrollArea.NoFrame)
        scroll.setWidget(inner)
        return scroll


def main():
    app = QApplication(sys.argv)
    app.setStyle("Fusion")
    base.install_identity(app)
    rend = cli.Renderer(cli.find_renderer(), cli.find_bundle(None))
    win = TabbedWindow(rend)

    args = [Path(a) for a in sys.argv[1:] if not a.startswith("-")]
    if args:
        first = args[0]
        if first.suffix.lower() == ".json":
            win.apply_session(cli.load_session(str(first)))
        else:
            win.load_path(first)
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
